<Project Sdk="Microsoft.NET.Sdk">

    <!-- Published with Native AOT by AotSmokeTests to check the library under trimming and AOT (D29) -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>TeamBanana.MatrixDotNet.AotSmoke</RootNamespace>
        <IsPackable>false</IsPackable>
        <PublishAot>true</PublishAot>
        <!-- Analyse all of the library, not only what this program happens to call, and fail on any warning -->
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\matrix.NET\matrix.NET.csproj" />
        <TrimmerRootAssembly Include="TeamBanana.MatrixDotNet" />
    </ItemGroup>

</Project>
